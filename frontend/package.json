{
  "name": "erp-ai-ocr-frontend",
  "version": "1.0.0",
  "author": {
    "name": "Open Source Contributors"
  },
  "description": "Supply & Production ERP with Dual-AI OCR Document Extraction",
  "private": true,
  "homepage": "./",
  "main": "public/electron.js",
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "dotenv": "^16.6.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "react-scripts": "5.0.1",
    "recharts": "^3.1.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "electron-forge start",
    "prebuild": "node -e \"['.env','.env.production','.env.local','.env.production.local'].forEach(function(f){require('dotenv').config({path:f,override:true})});if(!process.env.REACT_APP_API_BASE_URL){console.error('\\nBuild ERROR: REACT_APP_API_BASE_URL is not defined.\\n\\nThe CSP connect-src in public/index.html would keep the literal %REACT_APP_API_BASE_URL% placeholder, which the CSP parser discards: the app would open and EVERY API call would be silently blocked with no visible error.\\n\\nSet the variable in your shell or in .env / .env.production (same precedence order as CRA). See .env.example.\\n');process.exit(1)}console.log('[build] REACT_APP_API_BASE_URL =',process.env.REACT_APP_API_BASE_URL)\"",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "electron:dev": "concurrently \"cross-env BROWSER=none craco start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:publish": "npm run build && electron-builder --publish always",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "bench": "node scripts/bench-performance.js"
  },
  "build": {
    "appId": "com.erp.ocr.desktop",
    "productName": "ERP AI OCR",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "package.json"
    ],
    "afterPack": "./forge.config.js",
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "public/logo.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "ronanpjr",
      "repo": "milkmanagement"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 60,
        "functions": 70,
        "lines": 70
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-normalize": "^13.0.1",
    "postcss-preset-env": "^10.2.4",
    "tailwindcss": "^3.4.17",
    "wait-on": "^9.0.3",
    "ws": "^7.5.10"
  }
}
