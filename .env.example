# =============================================================================
# ERP AI OCR Starter — Environment Configuration
# Copy this file to `.env` before running `docker compose up`:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=erp_ocr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_local_dev_password

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://postgres:5432/erp_ocr_db
DB_USERNAME=postgres
DB_PASSWORD=changeme_local_dev_password

# Minimum 32-character secret for HMAC-SHA256 JWT signing
JWT_SECRET=replace-with-a-strong-random-jwt-secret-at-least-32-chars

# Initial admin credentials (seeded on first boot)
ADMIN_INITIAL_EMAIL=admin@erp-demo.local
ADMIN_INITIAL_PASSWORD=ChangeMeAdmin123!

# Spring profile: "demo" seeds synthetic suppliers, collections, and settlements
SPRING_PROFILES_ACTIVE=demo

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# --- Dual-AI OCR Pipeline ---
# Default OCR engine: "gemini" or "azure"
OCR_SERVICE_DEFAULT=gemini

# Option A: Google Gemini via Vertex AI (Application Default Credentials)
GEMINI_PROJECT_ID=your-gcp-project-id
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Option B: Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-document-intelligence-key

# --- Frontend ---
REACT_APP_API_BASE_URL=http://localhost:8080
